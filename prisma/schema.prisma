generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AboutContent {
  id            String   @id @default(cuid())
  aboutUs       String   @db.Text
  aboutOptica   String   @db.Text
  updatedAt     DateTime @updatedAt
  recentUpdates String   @db.Text
}

model Event {
  id                 String              @id @default(cuid())
  title              String
  description        String              @db.Text
  date               DateTime
  time               String?
  venue              String?
  category           String
  brochureUrl        String?
  isFeatured         Boolean             @default(false)
  registrationClosed Boolean             @default(false)
  createdAt          DateTime            @updatedAt
  updatedAt          DateTime            @updatedAt
  registrationStatus String              @default("OPEN")
  imageUrl           String?             @db.Text
  registrations      EventRegistration[]
  reports            EventReport[]
  flashAnnouncement  FlashAnnouncement?
}

model FlashAnnouncement {
  id           String    @id @default(cuid())
  eventId      String?   @unique
  title        String
  shortMessage String?   @db.Text
  link         String?
  active       Boolean   @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  updatedAt    DateTime  @updatedAt
  event        Event?    @relation(fields: [eventId], references: [id])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  rollNo    String
  email     String
  phone     String
  createdAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventReport {
  id            String    @id @default(cuid())
  eventId       String?
  title         String
  content       String    @db.Text
  coverImageUrl String?
  publishedAt   DateTime?
  createdAt     DateTime  @updatedAt
  updatedAt     DateTime  @updatedAt
  pdfUrl        String?
  isMom         Boolean   @default(false)
  event         Event?    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  year      String   @unique
  createdAt DateTime @default(now())
}

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  classification String
  post           String?
  imageUrl       String?  @db.Text
  email          String?
  phone          String?
  linkedin       String?  @db.Text
  order          Int      @default(0)
  createdAt      DateTime @updatedAt
  updatedAt      DateTime @updatedAt
  academicYear   String   @default("2025-26")
  category       String?

  @@index([academicYear])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @updatedAt
}

model RecentActivity {
  id          String                @id @default(cuid())
  title       String
  content     String                @db.Text
  pdfUrl      String?
  publishedAt DateTime?
  createdAt   DateTime              @updatedAt
  updatedAt   DateTime              @updatedAt
  images      RecentActivityImage[]

  @@index([publishedAt])
}

model RecentActivityImage {
  id         String         @id @default(cuid())
  activityId String
  imageUrl   String         @db.Text
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
  activity   RecentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model RecentActivityIntro {
  id        String   @id @default(cuid())
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model FooterLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FooterSettings {
  id            String   @id @default(cuid())
  copyrightText String   @db.Text
  linksHeading  String   @default("Other links")
  updatedAt     DateTime @updatedAt
}

model ContactPerson {
  id          String   @id @default(cuid())
  name        String
  designation String?
  email       String?
  phone       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
