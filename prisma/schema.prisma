// IEEE Student Chapter Website — Prisma schema
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Admin login only
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// About us / About Optica (home page content)
model AboutContent {
  id          String   @id @default(cuid())
  aboutUs     String   @db.Text // markdown or plain
  aboutOptica String   @db.Text
  recentUpdates String @db.Text
  updatedAt   DateTime @updatedAt
}

// Events: workshop, hackathon, quiz, webinar, invited talk
model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  date        DateTime
  time        String?
  venue       String?
  category    String   // WORKSHOP | HACKATHON | QUIZ | WEBINAR | INVITED_TALK
  brochureUrl       String?
  isFeatured        Boolean  @default(false)
  registrationClosed Boolean @default(false)
  registrationStatus String   @default("OPEN") // OPEN | SOON | CLOSED
  createdAt         DateTime @updatedAt
  updatedAt         DateTime @updatedAt

  flashAnnouncement FlashAnnouncement?
  registrations     EventRegistration[]
  reports           EventReport[]
}

model FlashAnnouncement {
  id           String   @id @default(cuid())
  eventId      String?  @unique
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title        String
  shortMessage String?  @db.Text
  link         String?
  active       Boolean  @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  updatedAt    DateTime @updatedAt
}

// Event registration: name, roll number, email, phone (when user clicks "Register now")
model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  rollNo    String
  email     String
  phone     String
  createdAt DateTime @updatedAt

  @@index([eventId])
}

// Event reports & MOM (standalone or optionally linked to an event)
model EventReport {
  id          String   @id @default(cuid())
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title       String
  content     String   @db.Text
  coverImageUrl String?
  pdfUrl      String?
  isMom       Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @updatedAt
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

// Academic years a team can be published for. Admin-managed, so a year can
// exist (and be offered on the team page) before any member is added to it.
model AcademicYear {
  id        String   @id @default(cuid())
  year      String   @unique // e.g. 2026-27
  createdAt DateTime @default(now())
}

// Team: faculty advisor, core, functional; post-wise, per academic year
model TeamMember {
  id           String   @id @default(cuid())
  name         String
  classification String // FACULTY_ADVISOR | CORE | FUNCTIONAL
  academicYear String   @default("2025-26") // e.g. 2025-26, 2026-27
  category     String?  // sub-team heading within the classification, e.g. "Web Development Team"
  post         String?  // e.g. Chair, Vice-Chair, Secretary
  imageUrl     String?  @db.Text
  email        String?
  phone        String?
  linkedin     String?  @db.Text
  order        Int      @default(0)
  createdAt    DateTime @updatedAt
  updatedAt    DateTime @updatedAt

  @@index([academicYear])
}

// Contact form submissions (public form)
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @updatedAt
}

// Recent activities (admin uploads PDF + description)
model RecentActivity {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  pdfUrl      String?
  publishedAt DateTime?
  createdAt   DateTime @updatedAt
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

// Intro text for Recent Activities page (single row)
model RecentActivityIntro {
  id        String   @id @default(cuid())
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

// Footer useful links (admin-editable)
model FooterLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Footer copyright / chapter line (single row, admin-editable)
model FooterSettings {
  id            String   @id @default(cuid())
  copyrightText String   @db.Text
  linksHeading  String   @default("Other links")
  updatedAt     DateTime @updatedAt
}

// People listed on the public contact page. Kept separate from TeamMember so
// an admin can list whoever should be contacted, in whatever order, without
// that choice being tied to the team roster.
model ContactPerson {
  id          String   @id @default(cuid())
  name        String
  designation String?
  email       String?
  phone       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
