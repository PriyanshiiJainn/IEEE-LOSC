# Copy to .env and fill in. Never commit .env.

# Database — MySQL (schema default) or PostgreSQL.
# MySQL:     mysql://USER:PASSWORD@HOST:3306/DATABASE
# PostgreSQL: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth (required for admin login in production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-for-production"
NODE_ENV=production

# Vercel Blob — required for PDF/image uploads on Vercel (serverless).
# Create a Blob store in the Vercel project; token is auto-injected in production.
# Local dev: omit to save uploads under public/pdfs and public/gallery instead.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# After running: npm run db:seed
# Admin login at /admin/login — Email: admin@ieee.lnmiit.ac.in  Password: admin123

