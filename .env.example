# Copy to .env and fill in. Never commit .env.

# Database (MySQL). Example: PlanetScale, Railway, or local.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Frontend-only (no MySQL): set to true to use mock data, no DB connection, fast.
# Remove or set to false when you have a real database.
USE_MOCK_DATA=true

# NextAuth (required for admin login)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-for-production"
