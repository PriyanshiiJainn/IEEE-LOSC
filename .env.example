# Copy to .env and fill in. Never commit .env.

# Database — PostgreSQL (e.g. Neon, Supabase, Railway) or MySQL.
# PostgreSQL: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# MySQL:     mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Frontend-only (no DB): set to true to use mock data, no DB connection, fast.
# When you have a database: remove this line or set to false to use the database and admin.
# USE_MOCK_DATA=true

# NextAuth (required for admin login)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-for-production"

# After running: npm run db:seed
# Admin login at /admin/login — Email: admin@ieee.lnmiit.ac.in  Password: admin123
